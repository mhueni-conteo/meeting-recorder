#!/usr/bin/env bash
set -e

# Restrict all recordings/transcripts to the owner
umask 077

# Configuration
SAVE_DIR="$HOME/Documents/Transcripts"
WHISPER_MODEL="base" # Options: tiny, base, small, medium, large
MIC_LABEL="Me"
SPEAKER_LABEL="Others"

TEMP_MIC=$(mktemp /tmp/meeting_rec.XXXXXX.mic.flac)
TEMP_SPK=$(mktemp /tmp/meeting_rec.XXXXXX.speaker.flac)
trap 'rm -f "$TEMP_MIC" "$TEMP_SPK"' EXIT

# Ensure output directory exists
mkdir -p "$SAVE_DIR"

# Check dependencies
command -v ffmpeg >/dev/null 2>&1 || { echo "Error: ffmpeg is not installed. Run: sudo dnf install ffmpeg-free (or ffmpeg from RPM Fusion)" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "Error: python3 is not installed." >&2; exit 1; }
python3 -c "import faster_whisper" 2>/dev/null || { echo "Error: faster-whisper is not installed. Run: python3 -m pip install --user faster-whisper" >&2; exit 1; }

# Session name: first command-line argument, or prompt if not provided
SESSION_NAME="$1"
if [ -z "$SESSION_NAME" ]; then
    read -rp "Enter session name: " SESSION_NAME
fi
if [ -z "$SESSION_NAME" ]; then
    SESSION_NAME="meeting"
fi

# Sanitize session name (replace spaces/special chars with underscores)
SAFE_NAME=$(echo "$SESSION_NAME" | tr ' ' '_' | tr -cd '[:alnum:]_-')
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BASE_FILENAME="${TIMESTAMP}-${SAFE_NAME}"

FINAL_MIC="${SAVE_DIR}/${BASE_FILENAME}.mic.flac"
FINAL_SPK="${SAVE_DIR}/${BASE_FILENAME}.speaker.flac"
FINAL_TXT="${SAVE_DIR}/${BASE_FILENAME}.txt"

echo ""
echo "=========================================================="
echo " Recording started!"
echo " Sources: Mic (you) + System audio (callers), saved separately"
echo " Press [Ctrl+C] when the meeting ends to stop and transcribe."
echo "=========================================================="
echo ""

# Handle Ctrl+C cleanly
cleanup_and_transcribe() {
    echo ""
    echo "=========================================================="
    echo " Recording stopped. Processing audio..."
    echo "=========================================================="

    if [ -f "$TEMP_MIC" ] && [ -f "$TEMP_SPK" ]; then
        mv "$TEMP_MIC" "$FINAL_MIC"
        mv "$TEMP_SPK" "$FINAL_SPK"
        echo "Audio saved to:"
        echo "  You:    $FINAL_MIC"
        echo "  Others: $FINAL_SPK"
        echo "Running faster-whisper transcription (model: $WHISPER_MODEL, int8)..."

        # Transcribe both channels and merge into one timestamped, speaker-labeled file.
        python3 - "$FINAL_MIC" "$FINAL_SPK" "$WHISPER_MODEL" "$MIC_LABEL" "$SPEAKER_LABEL" "$FINAL_TXT" <<'PYEOF'
import sys
from faster_whisper import WhisperModel

mic_path, spk_path, model_name, mic_label, spk_label, out_path = sys.argv[1:7]

model = WhisperModel(model_name, device="cpu", compute_type="float32", cpu_threads=16)

def events(path, label):
    segments, _ = model.transcribe(
        path,
        beam_size=5,
        word_timestamps=True,
        condition_on_previous_text=False,
    )
    ev = []
    for seg in segments:
        if seg.words:
            for w in seg.words:
                if w.start is not None:
                    ev.append((w.start, label, (w.word or "").strip()))
        elif seg.start is not None:
            ev.append((seg.start, label, (seg.text or "").strip()))
    return ev

ev = events(mic_path, mic_label) + events(spk_path, spk_label)
ev.sort(key=lambda e: e[0])

def fmt(t):
    s = int(t)
    return f"{s // 3600:02d}:{(s % 3600) // 60:02d}:{s % 60:02d}"

lines = []
cur = None  # (label, start, [words])
for start, label, text in ev:
    if not text:
        continue
    if cur is None or cur[0] != label:
        if cur is not None:
            lines.append(f"[{fmt(cur[1])}] {cur[0]}: {' '.join(cur[2])}")
        cur = (label, start, [text])
    else:
        cur[2].append(text)
if cur is not None:
    lines.append(f"[{fmt(cur[1])}] {cur[0]}: {' '.join(cur[2])}")

with open(out_path, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")
print(f"Transcript saved to: {out_path}")
PYEOF
    else
        echo "No recording was captured."
    fi

    # Open the transcript folder in the default file manager
    gio open "$SAVE_DIR" >/dev/null 2>&1 || true

    exit 0
}

# Trap SIGINT (Ctrl+C)
trap cleanup_and_transcribe SIGINT

# Record PulseAudio/PipeWire: mic ('default') and system output ('@DEFAULT_MONITOR@'),
# each into its own file so they stay separable for transcription.
ffmpeg -nostdin -y -loglevel warning \
  -f pulse -i default \
  -f pulse -i @DEFAULT_MONITOR@ \
  -map 0:a -c:a flac "$TEMP_MIC" \
  -map 1:a -c:a flac "$TEMP_SPK"

# Fallback if ffmpeg exits without SIGINT
cleanup_and_transcribe
